{
	"name": "dataflow_summary",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "sql_Payroll",
						"type": "DatasetReference"
					},
					"name": "payroll2020Source"
				},
				{
					"dataset": {
						"referenceName": "sql_Payroll",
						"type": "DatasetReference"
					},
					"name": "payroll2021Source"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "sql_PayrollSummary",
						"type": "DatasetReference"
					},
					"name": "SinkSQL"
				},
				{
					"dataset": {
						"referenceName": "ds_dirstaging",
						"type": "DatasetReference"
					},
					"name": "SinkADLS"
				}
			],
			"transformations": [
				{
					"name": "union1"
				},
				{
					"name": "filterFiscalYear"
				},
				{
					"name": "deriveTotalPaid"
				},
				{
					"name": "aggregateSummary"
				}
			],
			"scriptLines": [
				"parameters{",
				"     dataflow_param_fiscalyear as integer (2020)",
				"}",
				"source(output(",
				"          FiscalYear as integer,",
				"          PayrollNumber as string,",
				"          AgencyCode as string,",
				"          AgencyName as string,",
				"          EmployeeID as string,",
				"          LastName as string,",
				"          FirstName as string,",
				"          AgencyStartDate as date,",
				"          WorkLocationBorough as string,",
				"          TitleCode as string,",
				"          TitleDescription as string,",
				"          LeaveStatusasofJune30 as string,",
				"          BaseSalary as decimal(18,2),",
				"          PayBasis as string,",
				"          RegularHours as decimal(18,2),",
				"          RegularGrossPaid as decimal(18,2),",
				"          OTHours as decimal(18,2),",
				"          TotalOTPaid as decimal(18,2),",
				"          TotalOtherPay as decimal(18,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> payroll2020Source",
				"source(output(",
				"          FiscalYear as integer,",
				"          PayrollNumber as string,",
				"          AgencyCode as string,",
				"          AgencyName as string,",
				"          EmployeeID as string,",
				"          LastName as string,",
				"          FirstName as string,",
				"          AgencyStartDate as date,",
				"          WorkLocationBorough as string,",
				"          TitleCode as string,",
				"          TitleDescription as string,",
				"          LeaveStatusasofJune30 as string,",
				"          BaseSalary as decimal(18,2),",
				"          PayBasis as string,",
				"          RegularHours as decimal(18,2),",
				"          RegularGrossPaid as decimal(18,2),",
				"          OTHours as decimal(18,2),",
				"          TotalOTPaid as decimal(18,2),",
				"          TotalOtherPay as decimal(18,2)",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> payroll2021Source",
				"payroll2020Source, payroll2021Source union(byName: true)~> union1",
				"union1 filter(toInteger(FiscalYear) >= $dataflow_param_fiscalyear) ~> filterFiscalYear",
				"filterFiscalYear derive(TotalPaid = RegularGrossPaid + TotalOTPaid + TotalOtherPay) ~> deriveTotalPaid",
				"deriveTotalPaid aggregate(groupBy(AgencyName,",
				"          FiscalYear),",
				"     TotalPaid = sum(TotalPaid)) ~> aggregateSummary",
				"aggregateSummary sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          FiscalYear as integer,",
				"          AgencyName as string,",
				"          TotalPaid as double",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> SinkSQL",
				"aggregateSummary sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     truncate: true,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SinkADLS"
			]
		}
	}
}